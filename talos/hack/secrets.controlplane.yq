# yq expression (mikefarah/yq) that maps the decrypted talhelper secret bundle
# (talsecret.sops.yaml) into the CONTROL-PLANE-only secret documents: the CA
# private keys (repeated alongside their crt because machine.ca / cluster.ca /
# etcd.ca merge as a cert+key UNIT — a key-only patch would blank the crt), the
# service-account key, and the etcd secretbox encryption key.
#
# Usage (see the talos Taskfile):
#   sops -d talos/talsecret.sops.yaml | yq --from-file talos/hack/secrets.controlplane.yq
# `splitDoc` emits the two results as separate `---`-delimited YAML documents.
# This file contains ZERO secret values — only key-path remapping. Safe to commit.
[
  {
    "version": "v1alpha1",
    "machine": {
      "ca": {"crt": .certs.os.crt, "key": .certs.os.key}
    },
    "cluster": {
      "ca": {"crt": .certs.k8s.crt, "key": .certs.k8s.key},
      "aggregatorCA": {"crt": .certs.k8saggregator.crt, "key": .certs.k8saggregator.key},
      "serviceAccount": {"key": .certs.k8sserviceaccount.key},
      "etcd": {"ca": {"crt": .certs.etcd.crt, "key": .certs.etcd.key}}
    }
  },
  {
    "apiVersion": "v1alpha1",
    "kind": "KubeEtcdEncryptionConfig",
    "config": {
      "resources": [
        {
          "resources": ["secrets"],
          "providers": [
            {"secretbox": {"keys": [{"name": "key1", "secret": .secrets.secretboxencryptionsecret}]}},
            {"identity": {}}
          ]
        }
      ]
    }
  }
] | .[] | splitDoc
