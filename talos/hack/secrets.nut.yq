# yq expression (mikefarah/yq) that maps the decrypted NUT/UPS credentials
# (talenv.sops.yaml) into the nut-client ExtensionServiceConfig applied to every
# node. Kept out of base.yaml so the UPS username/password never touch git.
#
# Usage (see the talos Taskfile): sops -d talos/talenv.sops.yaml | yq -f talos/hack/secrets.nut.yq
# This file contains ZERO secret values — only key-path remapping. Safe to commit.
{
  "apiVersion": "v1alpha1",
  "kind": "ExtensionServiceConfig",
  "name": "nut-client",
  "configFiles": [
    {
      "content": "MONITOR ups@" + .upsmonHost + " 1 " + .upsmonUser + " " + .upsmonPass + " secondary\nSHUTDOWNCMD \"/sbin/poweroff\"",
      "mountPath": "/usr/local/etc/nut/upsmon.conf"
    }
  ]
}
