# yq expression (mikefarah/yq) that maps the decrypted talhelper secret bundle
# (talsecret.sops.yaml) into the Talos machine-config secret documents that
# EVERY node needs: only the CA *crt* (never the key) plus the join/bootstrap
# tokens and the cluster discovery identity.
#
# Usage (see the talos Taskfile):
#   sops -d talos/talsecret.sops.yaml | yq --from-file talos/hack/secrets.all.yq
# `splitDoc` emits the two results as separate `---`-delimited YAML documents.
# This file contains ZERO secret values — only key-path remapping. Safe to commit.
[
  {
    "version": "v1alpha1",
    "machine": {
      "token": .trustdinfo.token,
      "ca": {"crt": .certs.os.crt}
    },
    "cluster": {
      "token": .secrets.bootstraptoken,
      "ca": {"crt": .certs.k8s.crt}
    }
  },
  {
    "apiVersion": "v1alpha1",
    "kind": "DiscoveryIdentityConfig",
    "clusterID": .cluster.id,
    "clusterSecret": .cluster.secret
  }
] | .[] | splitDoc
