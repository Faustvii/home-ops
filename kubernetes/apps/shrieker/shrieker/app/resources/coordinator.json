    "scanner_runtime_class": "gvisor-offline",
    "scratch_bytes": 4294967296,
    "tools": {
      "aqua:anchore/grype": "v0.122.1",
      "aqua:anchore/syft": "v1.57.2",
      "aqua:home-operations/flate": "v0.8.0"
